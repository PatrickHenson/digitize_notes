# Model evaluation: never commit sample page images or their outputs —
# samples are often real (potentially confidential) handwritten notes.
/eval/sample_images/*
!/eval/sample_images/.gitkeep
/eval/results/*
!/eval/results/.gitkeep

# Node/Electron build artifacts (present on disk from the unmerged
# scaffold-electron-app branch's npm install; not part of this branch's
# work, kept out regardless of which branch is checked out)
node_modules
dist
out
.DS_Store
.eslintcache
*.log*
